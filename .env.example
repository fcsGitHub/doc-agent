# Database
DATABASE_URL=postgresql+asyncpg://docagent:docagent@localhost:5432/docagent

# LLM Configuration (via litellm)
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_REVIEW_MODEL=gpt-4o
LLM_EMBED_MODEL=text-embedding-3-small

# Mock LLM (set to true for offline/testing mode)
LITELLM_MOCK=false

# Seed demo data on startup (set to false to test empty state)
SEED_DEMO_DATA=true

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
